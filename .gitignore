# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Environnements virtuels
.venv/
.venv-*/
venv/
env/

# Django
*.sqlite3
db.sqlite3
staticfiles/
media/

# Variables d'environnement (jamais de secrets dans Git)
.env
.env.*
!.env.example
services/*/.env

# Node / Angular (frontend)
node_modules/
dist/
.angular/

# Kubernetes — secrets réels (garder uniquement les templates)
k8s/secrets/*.yaml
!k8s/secrets/*.template.yaml

# IDE / OS
.vscode/
.idea/
.DS_Store

# Claude Code — configuration locale, non partagée
.claude/

# Logs
*.log

# Clés JWT RS256 (générées via scripts/gen-jwt-keys.sh) — JAMAIS committées
**/keys/*.pem
**/keys/*.key

# Sauvegardes PostgreSQL locales (dumps) — jamais committées
/backups/
