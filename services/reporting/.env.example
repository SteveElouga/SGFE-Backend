# Reporting Service — variables d'environnement

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données (reporting_db — tables dénormalisées read-only)
REPORTING_DB_HOST=localhost
REPORTING_DB_PORT=5432
REPORTING_DB_NAME=reporting_db
REPORTING_DB_USER=reporting_user
REPORTING_DB_PASSWORD=

# gRPC
REPORTING_GRPC_PORT=50057

# Services externes consommés par le job de réconciliation nocturne
# (stats/schedulers.py) — sources de vérité pour recalculer StatsFacturation
# et StatsPaiements en cas d'événement Redis Streams manqué/perdu.
FACTURATION_GRPC_HOST=localhost
FACTURATION_GRPC_PORT=50054
PAIEMENT_GRPC_HOST=localhost
PAIEMENT_GRPC_PORT=50055

# Authentification de la couche gRPC interne — secret partagé entre tous les
# services. Sans lui, le serveur gRPC refuse de démarrer (fail-closed).
INTERNAL_GRPC_KEY=grpc-dev-placeholder-do-not-use-in-production

# Redis (flux d'événements consommé par le read model)
REDIS_URL=redis://localhost:6379/0
