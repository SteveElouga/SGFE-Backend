# .env.example — Auth Service
# Copier en .env et renseigner les valeurs [À_CONFIGURER]

ENVIRONMENT=development
DJANGO_SECRET_KEY=[À_CONFIGURER]
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=[À_CONFIGURER]

# gRPC
AUTH_GRPC_PORT=50051

# JWT (RS256 asymétrique — générer la paire de clés : ./scripts/gen-jwt-keys.sh)
# auth lit par défaut keys/jwt_private.pem et keys/jwt_public.pem (sous le service).
# Surcharger au besoin : JWT_PRIVATE_KEY_PATH=… / JWT_PUBLIC_KEY_PATH=…
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Sécurité
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# E-mail (Brevo — https://app.brevo.com, 300 e-mails/jour gratuits)
BREVO_API_KEY=[À_CONFIGURER]
BREVO_SENDER_NAME=SGFE
BREVO_SENDER_EMAIL=no-reply@sgfe.example.com

# Lien d'activation/réinitialisation (frontend Angular)
FRONTEND_URL=http://localhost:4200
PASSWORD_SETUP_TOKEN_VALIDITY_HOURS=48

# WhatsApp OTP (service Node.js whatsapp-web.js)
WHATSAPP_SERVICE_URL=http://whatsapp-service:3000
# Doit correspondre à WHATSAPP_INTERNAL_API_KEY du service whatsapp-service
WHATSAPP_INTERNAL_API_KEY=
