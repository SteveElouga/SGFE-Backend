# .env.example — Notification Service
# Copier en .env et renseigner les valeurs [À_CONFIGURER]

ENVIRONMENT=development
DJANGO_SECRET_KEY=[À_CONFIGURER]
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données
NOTIFICATION_DB_HOST=localhost
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=[À_CONFIGURER]

# gRPC — ce service
NOTIFICATION_GRPC_PORT=50056

# Clients gRPC vers autres services (adresses Kubernetes ClusterIP en prod)
FACTURATION_GRPC_HOST=localhost
FACTURATION_GRPC_PORT=50054

ABONNE_GRPC_HOST=localhost
ABONNE_GRPC_PORT=50052

CONFIG_GRPC_HOST=localhost
CONFIG_GRPC_PORT=50058

PAIEMENT_GRPC_HOST=localhost
PAIEMENT_GRPC_PORT=50055

# WhatsApp (service Node.js whatsapp-web.js)
# Scanner le QR code sur http://whatsapp-service:3000/qr pour activer l'envoi
WHATSAPP_SERVICE_URL=http://localhost:3000
# Doit correspondre à WHATSAPP_INTERNAL_API_KEY du service whatsapp-service
WHATSAPP_INTERNAL_API_KEY=

# Garde-fou de TEST UNIQUEMENT — voir la docstring de
# notifications/whatsapp_client.py. Laissée commentée ici volontairement :
# décommenter (valeur "1" ou "true") simule tout envoi WhatsApp (send /
# send_with_pdf) sans jamais contacter le vrai whatsapp-service — RÉSERVÉ
# aux stacks de test, jamais en développement normal ni en production.
# WHATSAPP_DISABLE_SEND_FOR_TESTS=1

# Frontend Angular (pour les liens tokenisés dans les messages)
FRONTEND_URL=http://localhost:4200

# Token d'accès abonné — durée par défaut (surchargeable via Config Service)
DEFAULT_TOKEN_VALIDITE_JOURS=20

# Authentification de la couche gRPC interne — secret partagé entre tous les
# services. Sans lui, le serveur gRPC refuse de démarrer (fail-closed).
INTERNAL_GRPC_KEY=grpc-dev-placeholder-do-not-use-in-production

# mTLS interne (GRPC_TLS_CA/GRPC_TLS_CERT/GRPC_TLS_KEY, voir docker-compose.yml)
# — repli en clair avec avertissement journalisé si absent. En production,
# positionner GRPC_TLS_REQUIRED=true pour refuser explicitement de démarrer
# plutôt que de retomber sur gRPC en clair (voir libs/sgfe_common/sgfe_common/grpc_auth.py).
GRPC_TLS_REQUIRED=false

# Chiffrement au repos de la PII transitant par ce service (numéro de
# téléphone WhatsApp destinataire). Sans elle, le service refuse de
# chiffrer/déchiffrer (fail-closed). Générer une vraie clé en local avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=[À_CONFIGURER]

# Redis (verrou de limite de débit WhatsApp + progression des diffusions)
REDIS_URL=redis://localhost:6379/0

# Limite de débit globale des envois WhatsApp (secondes minimum entre deux
# envois, tous déclencheurs confondus) — protège le compte WhatsApp Web
# partagé d'un risque de bannissement en cas de pic. 0 désactive la limite.
WHATSAPP_RATE_LIMIT_MIN_INTERVAL_SECONDS=3.0
