# .env.example — Notification Service
# Copier en .env et renseigner les valeurs [À_CONFIGURER]

ENVIRONMENT=development
DJANGO_SECRET_KEY=[À_CONFIGURER]
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données
NOTIFICATION_DB_HOST=localhost
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=[À_CONFIGURER]

# gRPC — ce service
NOTIFICATION_GRPC_PORT=50056

# Clients gRPC vers autres services (adresses Kubernetes ClusterIP en prod)
FACTURATION_GRPC_HOST=localhost
FACTURATION_GRPC_PORT=50054

ABONNE_GRPC_HOST=localhost
ABONNE_GRPC_PORT=50052

CONFIG_GRPC_HOST=localhost
CONFIG_GRPC_PORT=50058

PAIEMENT_GRPC_HOST=localhost
PAIEMENT_GRPC_PORT=50055

# WhatsApp (service Node.js whatsapp-web.js)
# Scanner le QR code sur http://whatsapp-service:3000/qr pour activer l'envoi
WHATSAPP_SERVICE_URL=http://localhost:3000
# Doit correspondre à WHATSAPP_INTERNAL_API_KEY du service whatsapp-service
WHATSAPP_INTERNAL_API_KEY=

# Frontend Angular (pour les liens tokenisés dans les messages)
FRONTEND_URL=http://localhost:4200

# Token d'accès abonné — durée par défaut (surchargeable via Config Service)
DEFAULT_TOKEN_VALIDITE_JOURS=20

# Authentification de la couche gRPC interne — secret partagé entre tous les
# services. Sans lui, le serveur gRPC refuse de démarrer (fail-closed).
INTERNAL_GRPC_KEY=grpc-dev-placeholder-do-not-use-in-production
