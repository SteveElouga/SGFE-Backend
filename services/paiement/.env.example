# Paiement Service — variables d'environnement

# Django
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données PostgreSQL
PAIEMENT_DB_HOST=localhost
PAIEMENT_DB_PORT=5432
PAIEMENT_DB_NAME=paiement_db
PAIEMENT_DB_USER=paiement_user
PAIEMENT_DB_PASSWORD=changeme

# gRPC — port d'écoute de ce service
PAIEMENT_GRPC_PORT=50055

# Services gRPC consommés
FACTURATION_GRPC_HOST=localhost
FACTURATION_GRPC_PORT=50054

NOTIFICATION_GRPC_HOST=localhost
NOTIFICATION_GRPC_PORT=50056

ABONNE_GRPC_HOST=localhost
ABONNE_GRPC_PORT=50052

CONFIG_GRPC_HOST=localhost
CONFIG_GRPC_PORT=50058


# Délais impayés (en jours depuis la date limite)
DEFAULT_DELAI_RAPPEL_1=0
DEFAULT_DELAI_RAPPEL_2=3
DEFAULT_DELAI_AVERTISSEMENT=7
DEFAULT_DELAI_SUSPENSION=10
DEFAULT_SUSPENSION_AUTO=True
DEFAULT_SUSPENSION_RELANCES=5

# Authentification de la couche gRPC interne — secret partagé entre tous les
# services. Sans lui, le serveur gRPC refuse de démarrer (fail-closed).
INTERNAL_GRPC_KEY=grpc-dev-placeholder-do-not-use-in-production
