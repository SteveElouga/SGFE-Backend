# .env.example — Abonné Service
# Copier en .env et renseigner les valeurs [À_CONFIGURER]

ENVIRONMENT=development
DJANGO_SECRET_KEY=[À_CONFIGURER]
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données
ABONNE_DB_HOST=localhost
ABONNE_DB_PORT=5432
ABONNE_DB_NAME=abonne_db
ABONNE_DB_USER=abonne_user
ABONNE_DB_PASSWORD=[À_CONFIGURER]

# gRPC
ABONNE_GRPC_PORT=50052

# Clients gRPC sortants — export RGPD uniquement (abonnes/export.py) :
# relevés, factures, paiements et envois WhatsApp d'un abonné.
CAMPAGNE_GRPC_HOST=localhost
CAMPAGNE_GRPC_PORT=50053
FACTURATION_GRPC_HOST=localhost
FACTURATION_GRPC_PORT=50054
PAIEMENT_GRPC_HOST=localhost
PAIEMENT_GRPC_PORT=50055
NOTIFICATION_GRPC_HOST=localhost
NOTIFICATION_GRPC_PORT=50056

# Authentification de la couche gRPC interne — secret partagé entre tous les
# services. Sans lui, le serveur gRPC refuse de démarrer (fail-closed).
INTERNAL_GRPC_KEY=grpc-dev-placeholder-do-not-use-in-production

# mTLS interne (GRPC_TLS_CA/GRPC_TLS_CERT/GRPC_TLS_KEY, voir docker-compose.yml)
# — repli en clair avec avertissement journalisé si absent. En production,
# positionner GRPC_TLS_REQUIRED=true pour refuser explicitement de démarrer
# plutôt que de retomber sur gRPC en clair (voir libs/sgfe_common/sgfe_common/grpc_auth.py).
GRPC_TLS_REQUIRED=false

# Chiffrement au repos des PII abonné (nom, prénom, téléphone WhatsApp,
# adresse). Sans elle, le service refuse de chiffrer/déchiffrer (fail-closed).
# Générer une vraie clé en local avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=[À_CONFIGURER]
