# Statut facture — calculé automatiquement
def calculer_statut(montant_total: float, montant_paye: float) -> str:
    if montant_paye <= 0:
        return 'IMPAYEE'
    elif montant_paye < montant_total:
        return 'PARTIELLE'
    else:
        return 'PAYEE'

# Référence transaction obligatoire pour Mobile Money / Virement
