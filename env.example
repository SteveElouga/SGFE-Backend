# .env.example — Template des variables d'environnement
# Système de Gestion de Facturation d'Eau
#
# INSTRUCTIONS :
#   1. Copier ce fichier : cp .env.example .env
#   2. Remplir TOUTES les valeurs marquées [À_CONFIGURER]
#   3. Ne JAMAIS committer le fichier .env dans Git
#   4. Chaque service a son propre .env dans son dossier

# =============================================
# VARIABLES GLOBALES (tous les services)
# =============================================

# Environnement : development | staging | production
ENVIRONMENT=development

# Django
DJANGO_SECRET_KEY=[À_CONFIGURER_GÉNÉRER_AVEC_python_-c_"from_django.core.management.utils_import_get_random_secret_key;_print(get_random_secret_key())"]
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*.ngrok.io

# =============================================
# API GATEWAY
# =============================================

# Port HTTP de l'API Gateway
GATEWAY_HTTP_PORT=8000

# Clé secrète JWT (partagée avec Auth Service pour validation)
JWT_SECRET_KEY=[À_CONFIGURER_MÊME_VALEUR_QUE_AUTH_SERVICE]
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Adresses gRPC des services (Kubernetes ClusterIP)
AUTH_GRPC_HOST=auth-service
AUTH_GRPC_PORT=50051

ABONNE_GRPC_HOST=abonne-service
ABONNE_GRPC_PORT=50052

CAMPAGNE_GRPC_HOST=campagne-service
CAMPAGNE_GRPC_PORT=50053

FACTURATION_GRPC_HOST=facturation-service
FACTURATION_GRPC_PORT=50054

PAIEMENT_GRPC_HOST=paiement-service
PAIEMENT_GRPC_PORT=50055

NOTIFICATION_GRPC_HOST=notification-service
NOTIFICATION_GRPC_PORT=50056

REPORTING_GRPC_HOST=reporting-service
REPORTING_GRPC_PORT=50057

CONFIG_GRPC_HOST=config-service
CONFIG_GRPC_PORT=50058

# Timeout gRPC en secondes
GRPC_TIMEOUT=30

# =============================================
# AUTH SERVICE
# =============================================

# Base de données
AUTH_DB_HOST=auth-postgres
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=[À_CONFIGURER]
AUTH_DATABASE_URL=postgresql://auth_user:[À_CONFIGURER]@auth-postgres:5432/auth_db

# gRPC
AUTH_GRPC_PORT=50051

# JWT
JWT_SECRET_KEY=[À_CONFIGURER_GÉNÉRER_ALÉATOIREMENT]
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Sécurité
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Bcrypt
BCRYPT_ROUNDS=12

# =============================================
# ABONNÉ SERVICE
# =============================================

# Base de données
ABONNE_DB_HOST=abonne-postgres
ABONNE_DB_PORT=5432
ABONNE_DB_NAME=abonne_db
ABONNE_DB_USER=abonne_user
ABONNE_DB_PASSWORD=[À_CONFIGURER]
ABONNE_DATABASE_URL=postgresql://abonne_user:[À_CONFIGURER]@abonne-postgres:5432/abonne_db

# gRPC
ABONNE_GRPC_PORT=50052

# Format numérotation abonnés
ABONNE_PREFIX=AB
ABONNE_NUMBER_PADDING=4

# =============================================
# CAMPAGNE SERVICE
# =============================================

# Base de données
CAMPAGNE_DB_HOST=campagne-postgres
CAMPAGNE_DB_PORT=5432
CAMPAGNE_DB_NAME=campagne_db
CAMPAGNE_DB_USER=campagne_user
CAMPAGNE_DB_PASSWORD=[À_CONFIGURER]
CAMPAGNE_DATABASE_URL=postgresql://campagne_user:[À_CONFIGURER]@campagne-postgres:5432/campagne_db

# gRPC
CAMPAGNE_GRPC_PORT=50053

# Scheduler (cron job planification campagnes)
# Format cron : heure de vérification (7h00 = 07:00)
CAMPAGNE_SCHEDULER_HEURE=7
CAMPAGNE_SCHEDULER_MINUTE=0

# =============================================
# FACTURATION SERVICE
# =============================================

# Base de données
FACTURATION_DB_HOST=facturation-postgres
FACTURATION_DB_PORT=5432
FACTURATION_DB_NAME=facturation_db
FACTURATION_DB_USER=facturation_user
FACTURATION_DB_PASSWORD=[À_CONFIGURER]
FACTURATION_DATABASE_URL=postgresql://facturation_user:[À_CONFIGURER]@facturation-postgres:5432/facturation_db

# gRPC
FACTURATION_GRPC_PORT=50054

# Format numérotation factures
FACTURE_PREFIX=FACT

# Stockage des PDFs
PDF_STORAGE_PATH=/app/media/factures
PDF_BASE_URL=https://[VOTRE_DOMAINE_NGROK]/media/factures

# Tarif par défaut (en FCFA)
PRIX_M3_DEFAUT=500

# =============================================
# PAIEMENT SERVICE
# =============================================

# Base de données
PAIEMENT_DB_HOST=paiement-postgres
PAIEMENT_DB_PORT=5432
PAIEMENT_DB_NAME=paiement_db
PAIEMENT_DB_USER=paiement_user
PAIEMENT_DB_PASSWORD=[À_CONFIGURER]
PAIEMENT_DATABASE_URL=postgresql://paiement_user:[À_CONFIGURER]@paiement-postgres:5432/paiement_db

# gRPC
PAIEMENT_GRPC_PORT=50055

# Délai de paiement par défaut (en jours)
DELAI_PAIEMENT_JOURS=5

# Scheduler impayés (cron job — 8h00 chaque matin)
IMPAYE_SCHEDULER_HEURE=8
IMPAYE_SCHEDULER_MINUTE=0

# Délais de relance impayés (en jours après date limite)
IMPAYE_DELAI_RAPPEL_1=0
IMPAYE_DELAI_RAPPEL_2=3
IMPAYE_DELAI_AVERTISSEMENT=7
IMPAYE_DELAI_SUSPENSION=10

# Suspension automatique des lignes d'eau
IMPAYE_SUSPENSION_AUTO=true

# Suspension des relances après versement partiel (en jours)
IMPAYE_SUSPENSION_RELANCES_PARTIEL=5

# =============================================
# NOTIFICATION SERVICE
# =============================================

# Base de données
NOTIFICATION_DB_HOST=notification-postgres
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=[À_CONFIGURER]
NOTIFICATION_DATABASE_URL=postgresql://notification_user:[À_CONFIGURER]@notification-postgres:5432/notification_db

# gRPC
NOTIFICATION_GRPC_PORT=50056

# Telnyx WhatsApp API
TELNYX_API_KEY=[À_CONFIGURER_DEPUIS_TABLEAU_DE_BORD_TELNYX]
TELNYX_WHATSAPP_NUMBER=[À_CONFIGURER_EX:+237600000000]
TELNYX_API_URL=https://api.telnyx.com/v2

# Retry en cas d'échec d'envoi WhatsApp
WHATSAPP_MAX_RETRIES=3
WHATSAPP_RETRY_DELAY_SECONDS=30

# Token d'accès espace abonné
TOKEN_VALIDITE_JOURS=20

# URL de base pour les liens tokenisés
APP_BASE_URL=https://[VOTRE_URL_NGROK]
ESPACE_ABONNE_PATH=/espace

# =============================================
# REPORTING SERVICE
# =============================================

# Base de données
REPORTING_DB_HOST=reporting-postgres
REPORTING_DB_PORT=5432
REPORTING_DB_NAME=reporting_db
REPORTING_DB_USER=reporting_user
REPORTING_DB_PASSWORD=[À_CONFIGURER]
REPORTING_DATABASE_URL=postgresql://reporting_user:[À_CONFIGURER]@reporting-postgres:5432/reporting_db

# gRPC
REPORTING_GRPC_PORT=50057

# =============================================
# CONFIG SERVICE
# =============================================

# Base de données
CONFIG_DB_HOST=config-postgres
CONFIG_DB_PORT=5432
CONFIG_DB_NAME=config_db
CONFIG_DB_USER=config_user
CONFIG_DB_PASSWORD=[À_CONFIGURER]
CONFIG_DATABASE_URL=postgresql://config_user:[À_CONFIGURER]@config-postgres:5432/config_db

# gRPC
CONFIG_GRPC_PORT=50058

# =============================================
# INFORMATIONS DE LA SOCIÉTÉ (valeurs initiales)
# =============================================

SOCIETE_NOM=[À_CONFIGURER_EX:Société_Eau_de_ma_Ville]
SOCIETE_ADRESSE=[À_CONFIGURER]
SOCIETE_TELEPHONE=[À_CONFIGURER]

# =============================================
# OBSERVABILITÉ
# =============================================

# OpenTelemetry
OTEL_SERVICE_NAME=[NOM_DU_SERVICE]
OTEL_EXPORTER_JAEGER_AGENT_HOST=jaeger-service
OTEL_EXPORTER_JAEGER_AGENT_PORT=6831
OTEL_TRACES_EXPORTER=jaeger
OTEL_METRICS_EXPORTER=prometheus
OTEL_LOGS_EXPORTER=none

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=[À_CONFIGURER]
GRAFANA_PORT=3000

# Loki
LOKI_URL=http://loki-service:3100

# Jaeger
JAEGER_UI_PORT=16686
JAEGER_COLLECTOR_PORT=14268

# =============================================
# KUBERNETES / DÉPLOIEMENT
# =============================================

# Namespace Kubernetes
K8S_NAMESPACE=facturation-eau

# Stratégie Canary
CANARY_WEIGHT=10
CANARY_PROMOTION_DELAY_MINUTES=30

# Image Docker (registry local Minikube)
DOCKER_REGISTRY=facturation-eau
IMAGE_TAG=latest

# =============================================
# DÉVELOPPEMENT LOCAL UNIQUEMENT
# =============================================

# ngrok (rempli automatiquement au démarrage)
NGROK_AUTH_TOKEN=[À_CONFIGURER_DEPUIS_TABLEAU_DE_BORD_NGROK]
NGROK_DOMAIN=[VOTRE_URL_NGROK_EX:xyz.ngrok.io]

# Override des adresses gRPC pour le développement local (sans Kubernetes)
# Décommenter et adapter si vous lancez les services directement sans K8s
# AUTH_GRPC_HOST=localhost
# ABONNE_GRPC_HOST=localhost
# CAMPAGNE_GRPC_HOST=localhost
# FACTURATION_GRPC_HOST=localhost
# PAIEMENT_GRPC_HOST=localhost
# NOTIFICATION_GRPC_HOST=localhost
# REPORTING_GRPC_HOST=localhost
# CONFIG_GRPC_HOST=localhost

# =============================================
# NOTES IMPORTANTES
# =============================================
#
# 1. Copier dans chaque service :
#    cp .env.example services/auth/.env
#    cp .env.example services/abonne/.env
#    ... etc
#    Puis ne garder que les variables pertinentes pour ce service.
#
# 2. Dans Kubernetes, ces variables sont injectées via :
#    - ConfigMaps (variables non sensibles)
#    - Secrets (mots de passe, clés API, JWT secret)
#
# 3. Le fichier .env NE DOIT JAMAIS être commité dans Git.
#    Vérifier que .gitignore contient bien : .env et **/.env
#
# 4. Pour générer un JWT_SECRET_KEY fort :
#    python -c "import secrets; print(secrets.token_hex(64))"
#
# 5. Pour générer un DJANGO_SECRET_KEY :
#    python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
