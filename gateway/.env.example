# .env.example — API Gateway
# Copier en .env et renseigner les valeurs [À_CONFIGURER]

ENVIRONMENT=development
DJANGO_SECRET_KEY=[À_CONFIGURER]
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*.ngrok.io

GATEWAY_HTTP_PORT=8000
GRPC_TIMEOUT=30

AUTH_GRPC_HOST=localhost
AUTH_GRPC_PORT=50051

ABONNE_GRPC_HOST=localhost
ABONNE_GRPC_PORT=50052

# Cookie HttpOnly du refresh token — True en production (HTTPS via ngrok),
# False en local pour tester en http://localhost
COOKIE_SECURE=False
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
